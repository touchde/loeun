{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loeun",
  "mainBinaryName": "loeun-desktop",
  "identifier": "io.github.touchde.loeun",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Loeun",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast, open-source download manager",
    "longDescription": "Loeun is a fast, open-source, cross-platform download manager with multi-connection acceleration and crash-safe resume.",
    "copyright": "Copyright (c) 2026 The Loeun Contributors",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
